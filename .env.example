# =============================================================================
# Client (Vite) — only VITE_* vars are exposed to the browser bundle.
# Prefer setting AI API keys in the app Settings / ApiKeyModal (stored locally).
# =============================================================================

# Optional: override API base URL (default: /api)
# VITE_API_URL=/api

# =============================================================================
# Server / Vercel serverless (api/sync.ts, scripts/migrate.js)
# Never prefix secrets with VITE_ — they must not ship to the client.
# =============================================================================

# Neon PostgreSQL — required for cloud sync (https://neon.tech)
DATABASE_URL=postgresql://username:password@host/neondb?sslmode=require

# CORS allowlist for the sync API (defaults to production Vercel host)
ALLOWED_ORIGIN=https://your-domain.vercel.app

# Rate limit per IP per minute (default: 20)
RATE_LIMIT=20
